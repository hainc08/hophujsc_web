{
  "name": "hopphujsc-web",
  "private": true,
  "version": "0.1.0",
  "description": "Bản dựng front-end cho redesign hopphujsc.com (design system + trang chủ). Không có dependency.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:index": "node build.mjs --index",
    "build:pages": "node build.mjs --target=pages",
    "build:review": "node build.mjs --target=review",
    "build:production": "node build.mjs --target=production",
    "serve": "node serve.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
